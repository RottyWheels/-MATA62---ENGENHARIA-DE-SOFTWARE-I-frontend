# Alvo do proxy do Vite em desenvolvimento (/api, /ws, /v3/api-docs)
VITE_BACKEND_URL=http://localhost:8080
# true = usa MSW no navegador e dispensa o backend
VITE_ENABLE_MOCKS=false
# true = mostra "Simular pagamento" no Pix e na página de status (só em pnpm dev, nunca no build).
# O backend precisa de PAYMENT_SIMULATION_ENABLED=true (já vem ligado no Docker Compose).
VITE_ENABLE_PAYMENT_SIMULATION=true
